# ─── PostgreSQL / Supabase ───────────────────────────────────────
# For Supabase, get this from Project Settings -> Database -> Connection string -> URI
# Example: postgresql://postgres.xxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://ksp_admin:ksp_secure_2024@localhost:5432/ksp_crime_db
DATABASE_URL_SYNC=postgresql+psycopg://ksp_admin:ksp_secure_2024@localhost:5432/ksp_crime_db

# ─── LLM Configuration (Ollama OR Groq/Together) ─────────────────
# Option A: Local Ollama (Default)
OLLAMA_BASE_URL=http://localhost:11434
SQL_MODEL=sqlcoder
ANSWER_MODEL=llama3.1:8b

# Option B: Free API (Groq)
# OLLAMA_BASE_URL=https://api.groq.com/v1
# SQL_MODEL=llama-3.3-70b-versatile
# ANSWER_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=your_groq_api_key_here

# ─── Backend ─────────────────────────────────────────────────────
JWT_SECRET=ksp-hackathon-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
CORS_ORIGINS=http://localhost:3000
BACKEND_PORT=8000

# ─── Frontend ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
